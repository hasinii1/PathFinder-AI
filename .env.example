import streamlit as st
from utils.data_loader import load_json
from components.styles import apply_styles

apply_styles()

st.title("🗺️ Career Roadmap")

st.write("Follow your personalized career learning roadmap.")

roadmap = load_json("data/roadmap.json")

if roadmap:

    if isinstance(roadmap, list):

        for i, step in enumerate(roadmap, start=1):
            st.markdown(f"### Step {i}")

            if isinstance(step, dict):
                for key, value in step.items():
                    st.write(
                        f"**{key.replace('_', ' ').title()}:** {value}"
                    )
            else:
                st.write(step)

    elif isinstance(roadmap, dict):

        for stage, details in roadmap.items():
            st.subheader(stage)
            st.write(details)

else:
    st.info("No roadmap data found.")